#!/usr/bin/env python3
"""cui-img <image file> [caption] — store an image in the claude-ui DB (claude_img) and print the markdown
reference to put in a chat message: ![caption](cui-img:<id>). The chat page renders it inline, fetching the
bytes through PostgREST (api.claude_img, admin-gated) — the image never needs a public URL.
Same DSN/schema env as the relay (CLAUDE_UI_PG / DBURI, CLAUDE_UI_SCHEMA). Re-posting identical bytes
reuses the existing row (sha256)."""
import hashlib, os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "relay"))
import db  # noqa: E402

MIME = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}
MAX_BYTES = 15 * 1024 * 1024

def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr); sys.exit(2)
    path = sys.argv[1]; caption = " ".join(sys.argv[2:]).strip() or os.path.basename(path)
    mime = MIME.get(os.path.splitext(path)[1].lower())
    if not mime: sys.exit(f"cui-img: unsupported type {path} (png/jpg/gif/webp)")
    data = open(path, "rb").read()
    if len(data) > MAX_BYTES: sys.exit(f"cui-img: {len(data)} bytes > {MAX_BYTES} limit")
    sha = hashlib.sha256(data).hexdigest()
    with db.connect(autocommit=True) as con:
        row = con.execute(
            """INSERT INTO claude_img (mime, caption, bytes, sha256) VALUES (%s, %s, %s, %s)
               ON CONFLICT (sha256) DO UPDATE SET caption = COALESCE(EXCLUDED.caption, claude_img.caption)
               RETURNING id""", (mime, caption, data, sha)).fetchone()
    img_id = row[0] if not isinstance(row, dict) else row["id"]
    alt = caption.replace("]", ")").replace("\n", " ")
    print(f"![{alt}](cui-img:{img_id})")

if __name__ == "__main__":
    main()
